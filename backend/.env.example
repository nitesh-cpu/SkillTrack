# Copy to .env for local development. Do not commit populated environment files.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/skilltrack
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_EXPIRES_MINUTES=30
# Leave SMTP values unset until a mail server is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SEED_ADMIN_EMAIL=admin@skilltrack.local
SEED_ADMIN_PASSWORD=
DEV_DEMO_ACCOUNTS=false
DEV_DEMO_PASSWORD=
